	Vector2(40.835990264792, 44.197489325769),   # S3  r=20.667
	Vector2(33.044493270216, 15.409846273352),   # S4  r=13.563
	Vector2(37.364641401712, 53.728611961036),   # S5  r=27.380
	# ---- 🆕 E8-A 新增两外哨 ----
	Vector2(2.09894, 25.73395),                  # S6  西侧远哨  r=26, θ=185°
	Vector2(51.56400, 17.01193),                 # S7  东南远哨  r=26, θ=335°
]


static func build8():
