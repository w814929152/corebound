[gd_scene load_steps=9 format=3]

; 《守核 Corebound》切片3 骨架场景 —— 实时商店覆盖层
;
; 🔴 层号来自 GDD §2.4 分层表（常量在 scripts/engine/mvp_config.gd）：
;     战场 HUD 10 · 商店覆盖层 100 · 边缘红光脉冲 120 · 核心 HP 130 · 二次确认弹窗 140
;
; 🔴 process_mode（Node.ProcessMode）：
;     3 = PROCESS_MODE_ALWAYS —— 安全窗（get_tree().paused = true）下仍要跑的节点
;     0 = PROCESS_MODE_INHERIT —— 战场层必须随暂停停止（红线 SR-R1 的反面：世界真的停）
;
; 布局说明：Control 的锚点一律**在脚本里**用 set_anchors_preset()/set_offset() 设置，
;   不在 .tscn 里写 anchors_preset —— 4.7.2 实测直接赋值 anchors_preset 会静默失效
;   （见 docs/phase3/slice3-godot47-api-probe.log 的 E 段）。

[ext_resource type="Script" path="res://scripts/ui/battle_shop.gd" id="1_root"]
[ext_resource type="Script" path="res://scripts/ui/time_director.gd" id="2_td"]
[ext_resource type="Script" path="res://scripts/ui/battlefield_placeholder.gd" id="3_bf"]
[ext_resource type="Script" path="res://scripts/ui/monster_layer.gd" id="8_ml"]
[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="4_hud"]
[ext_resource type="Script" path="res://scripts/ui/shop_overlay.gd" id="5_shop"]
[ext_resource type="Script" path="res://scripts/ui/threat_pulse.gd" id="6_pulse"]
[ext_resource type="Script" path="res://scripts/ui/core_hp_bar.gd" id="7_hp"]

[node name="BattleShop" type="Node"]
script = ExtResource("1_root")

[node name="TimeDirector" type="Node" parent="."]
process_mode = 3
script = ExtResource("2_td")

[node name="Battlefield" type="Node2D" parent="."]
script = ExtResource("3_bf")

[node name="MonsterLayer" type="Node2D" parent="Battlefield"]
script = ExtResource("8_ml")

[node name="HudLayer" type="CanvasLayer" parent="."]
layer = 10
process_mode = 3

[node name="Hud" type="Control" parent="HudLayer"]
script = ExtResource("4_hud")

[node name="ShopLayer" type="CanvasLayer" parent="."]
layer = 100
process_mode = 3

[node name="ShopOverlay" type="Control" parent="ShopLayer"]
script = ExtResource("5_shop")

[node name="PulseLayer" type="CanvasLayer" parent="."]
layer = 120
process_mode = 3

[node name="ThreatPulse" type="Control" parent="PulseLayer"]
script = ExtResource("6_pulse")

[node name="CoreHpLayer" type="CanvasLayer" parent="."]
layer = 130
process_mode = 3

[node name="CoreHpBar" type="Control" parent="CoreHpLayer"]
script = ExtResource("7_hp")
